    {"title": "Workflow executions & status", "type": "row", "id": 103, "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}, "panels": []},
    {
      "title": "Executions by status over time",
      "type": "timeseries",
      "id": 41,
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "texera-pg"},
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 32},
      "targets": [{"refId": "A", "format": "time_series", "rawQuery": true, "rawSql": "SELECT date_trunc('hour', starting_time) AS time, CASE status WHEN 0 THEN 'ready' WHEN 1 THEN 'running' WHEN 2 THEN 'paused' WHEN 3 THEN 'completed' WHEN 4 THEN 'failed' WHEN 5 THEN 'killed' ELSE 'other' END AS metric, count(*) AS value FROM texera_db.workflow_executions WHERE $__timeFilter(starting_time) GROUP BY 1, 2 ORDER BY 1"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode": "normal"}}}}
    },
    {
      "title": "Executions per user (total / failed)",
      "type": "table",
      "id": 42,
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "texera-pg"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32},
      "targets": [{"refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT u.email AS user_email, count(*) AS total, count(*) FILTER (WHERE e.status = 3) AS completed, count(*) FILTER (WHERE e.status = 4) AS failed, count(*) FILTER (WHERE e.status = 1) AS running FROM texera_db.workflow_executions e JOIN texera_db.\"user\" u ON u.uid = e.uid GROUP BY u.email ORDER BY total DESC LIMIT 30"}],
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}}
    },
    {
      "title": "Recent failed executions",
      "type": "table",
      "id": 43,
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "texera-pg"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 40},
      "targets": [{"refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT e.eid, u.email AS user_email, w.name AS workflow, e.name AS execution, e.starting_time AS started, e.last_update_time AS last_update, ROUND(EXTRACT(EPOCH FROM (e.last_update_time - e.starting_time))::numeric, 1) AS duration_s, e.cuid FROM texera_db.workflow_executions e JOIN texera_db.workflow_version wv ON wv.vid = e.vid JOIN texera_db.workflow w ON w.wid = wv.wid JOIN texera_db.\"user\" u ON u.uid = e.uid WHERE e.status = 4 ORDER BY e.starting_time DESC LIMIT 50"}],
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}}
    }
