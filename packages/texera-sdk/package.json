{
  "name": "@texera/sdk",
  "version": "0.1.0",
  "description": "Shared TypeScript client and workflow-graph model for Apache Texera services",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "ajv": "8.18.0",
    "dagre": "0.8.5",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/dagre": "0.7.54",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
